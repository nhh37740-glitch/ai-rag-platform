{
  "package": "storage",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.5.1",
  "schema": {
    "tables": [
      "users",
      "notebooks",
      "notebook_members",
      "documents",
      "conversations",
      "agent_data"
    ],
    "database_path": "shared"
  },
  "facade": {
    "SqliteVectorStore": {
      "init": {
        "connection": "sqlite3.Connection|str",
        "lock": "RLock|null"
      },
      "methods": [
        "add",
        "replace_embeddings",
        "search",
        "list_documents",
        "document_chunks"
      ]
    },
    "StateStore": {
      "init": {
        "connection": "sqlite3.Connection|str",
        "lock": "RLock|null"
      }
    },
    "NotebookStore": {
      "init": {
        "connection": "sqlite3.Connection|str",
        "lock": "RLock|null"
      },
      "methods": [
        "register_user",
        "list_users",
        "create_notebook",
        "get_notebook",
        "list_notebooks",
        "membership_snapshot",
        "list_members",
        "put_member",
        "delete_member",
        "update_notebook",
        "delete_notebook"
      ]
    }
  }
}
