{
  "package": "rag_tools",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.3.1",
  "notes": "RAG 工具模块：向 LLM 公布知识库检索工具，执行时只访问当前会话选中的知识库。",
  "tools": [
    "search_knowledge_base",
    "hybrid_search_knowledge_base",
    "keyword_search_knowledge_base",
    "list_knowledge_documents",
    "read_knowledge_document"
  ],
  "facade": {
    "RagTools": {
      "kind": "class",
      "init": {
        "store": "VectorStore",
        "tracing": "TraceStore",
        "top_k": "int=5"
      },
      "methods": {
        "tool_definitions": {
          "params": {},
          "returns": "list[ToolDef]"
        },
        "search": {
          "params": {
            "ctx": "RequestContext",
            "query": "str",
            "knowledge_base_ids": "list[str]",
            "top_k": "int|null"
          },
          "returns": "str"
        },
        "keyword_search": {
          "params": {
            "ctx": "RequestContext",
            "query": "str",
            "knowledge_base_ids": "list[str]",
            "top_k": "int|null"
          },
          "returns": "str"
        },
        "hybrid_search": {
          "params": {
            "ctx": "RequestContext",
            "query": "str",
            "knowledge_base_ids": "list[str]",
            "top_k": "int|null"
          },
          "returns": "str"
        },
        "list_documents": {
          "params": {
            "ctx": "RequestContext",
            "knowledge_base_ids": "list[str]"
          },
          "returns": "str"
        },
        "read_document": {
          "params": {
            "ctx": "RequestContext",
            "source_id": "str",
            "knowledge_base_ids": "list[str]",
            "offset": "int",
            "max_chunks": "int|null"
          },
          "returns": "str",
          "notes": "source_id 必须属于所选知识库；分页读取，返回值含 total_chunks/truncated/next_offset"
        }
      }
    }
  }
}
