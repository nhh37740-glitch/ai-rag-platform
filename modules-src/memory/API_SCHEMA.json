{
  "package": "memory",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.3.0",
  "storage": "agent_data table in the shared six-table database",
  "facade": {
    "MemoryStore": {
      "init": {
        "connection": "sqlite3.Connection|str",
        "lock": "RLock|null"
      },
      "methods": [
        "get",
        "write",
        "search",
        "forget",
        "close"
      ]
    },
    "make_memory": {
      "params": {
        "db_path": "str"
      },
      "returns": "MemoryStore"
    }
  }
}
