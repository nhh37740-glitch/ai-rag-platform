{
  "package": "memory",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.2.0",
  "facade": {
    "MemoryStore": {
      "kind": "class",
      "methods": {
        "get": {
          "params": {
            "ctx": "RequestContext",
            "namespace": "str",
            "key": "str"
          },
          "returns": "MemoryEntry|null"
        },
        "write": {
          "params": {
            "ctx": "RequestContext",
            "namespace": "str",
            "key": "str",
            "content": "str",
            "importance": "float"
          },
          "returns": "MemoryEntry"
        },
        "search": {
          "params": {
            "ctx": "RequestContext",
            "namespace": "str",
            "query": "str",
            "top_k": "int"
          },
          "returns": "list[MemoryEntry]"
        },
        "forget": {
          "params": {
            "ctx": "RequestContext",
            "namespace": "str",
            "key": "str"
          },
          "returns": "None"
        },
        "close": {
          "params": {},
          "returns": "None"
        }
      }
    },
    "make_memory": {
      "kind": "function",
      "params": {
        "db_path": "str"
      },
      "returns": "MemoryStore"
    }
  }
}
