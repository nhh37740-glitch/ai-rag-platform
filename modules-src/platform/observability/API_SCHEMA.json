{
  "package": "observability",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.1.1",
  "facade": {
    "Span": {
      "kind": "class",
      "init": {
        "ctx": "RequestContext",
        "name": "str",
        "store": "TraceStore|null"
      },
      "notes": "sync context manager"
    },
    "TraceStore": {
      "kind": "class",
      "methods": {
        "record": {
          "params": {
            "span": "SpanEvent"
          },
          "returns": "None"
        },
        "get": {
          "params": {
            "trace_id": "str"
          },
          "returns": "list[SpanEvent]"
        }
      }
    }
  }
}
