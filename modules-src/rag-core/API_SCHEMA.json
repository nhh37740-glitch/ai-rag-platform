{
  "package": "rag_core",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.5.0",
  "constants": {
    "DEFAULT_READ_CHUNKS": 20,
    "MAX_READ_CHUNKS": 100
  },
  "embedding": {
    "default_backend": "fastembed",
    "default_model": "BAAI/bge-small-zh-v1.5",
    "fallback": "disabled; hash requires explicit RAG_EMBED=hash"
  },
  "facade": {
    "RagClient": {
      "kind": "class",
      "init": {
        "store": "VectorStore",
        "embed_fn": "callable",
        "top_k": "int=5"
      },
      "methods": {
        "retrieve": {
          "params": {
            "ctx": "RequestContext",
            "query": "str",
            "scope": "str|list[str]|null",
            "top_k": "int|null"
          },
          "returns": "RetrievalResult",
          "blocking_io": true
        }
      }
    },
    "embed": {
      "kind": "function",
      "params": {
        "texts": "list[str]"
      },
      "returns": "list[list[float]]",
      "blocking_io": false
    },
    "VectorStore": {
      "kind": "protocol",
      "methods": {
        "add": {
          "params": {
            "source_id": "str",
            "chunks": "list[str]",
            "embeddings": "obj"
          },
          "returns": "None"
        },
        "search": {
          "params": {
            "embedding": "obj",
            "top_k": "int",
            "scopes": "list[str]|null"
          },
          "returns": "list[tuple[str,str,float]]"
        },
        "list_documents": {
          "params": {
            "scopes": "list[str]|null"
          },
          "returns": "list[tuple[str,int]]"
        },
        "document_chunks": {
          "params": {
            "source_id": "str"
          },
          "returns": "list[str]"
        }
      }
    },
    "InMemoryVectorStore": {
      "kind": "class"
    },
    "keyword_search": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "query": "str",
        "store": "VectorStore",
        "scope": "str|list[str]|null",
        "top_k": "int"
      },
      "returns": "RetrievalResult",
      "notes": "纯词面打分，不调用向量模型"
    },
    "hybrid_search": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "query": "str",
        "store": "VectorStore",
        "scope": "str|list[str]|null",
        "top_k": "int",
        "alpha": "float"
      },
      "returns": "RetrievalResult",
      "notes": "向量与词面排序的 RRF 融合"
    },
    "list_documents": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "store": "VectorStore",
        "scope": "str|list[str]|null"
      },
      "returns": "list[dict]"
    },
    "read_document": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "store": "VectorStore",
        "source_id": "str",
        "max_chunks": "int",
        "offset": "int"
      },
      "returns": "RetrievalResult",
      "notes": "分页读取；默认只返回 DEFAULT_READ_CHUNKS 块，每个 Citation.metadata 含 chunk_index 与 total_chunks"
    },
    "document_info": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "store": "VectorStore",
        "source_id": "str"
      },
      "returns": "dict",
      "notes": "{source_id,title,knowledge_base_id,chunk_count}；未知 id 时 chunk_count 为 0"
    }
  }
}
