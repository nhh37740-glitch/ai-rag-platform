{
  "package": "data_facade",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.2.0",
  "facade": {
    "DataService": {
      "kind": "class",
      "init": {
        "state_dir": "str",
        "memory_db_path": "str|null",
        "vector_db_path": "str|null"
      },
      "methods": {
        "initialize": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "None"
        },
        "memory_store": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "MemoryStorePort"
        },
        "vector_store": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "VectorStore"
        },
        "state_db": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "StateStorePort"
        },
        "close": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "None"
        },
        "notebook_store": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "NotebookStorePort"
        },
        "create_notebook": {
          "params": {
            "ctx": "RequestContext",
            "metadata": "dict"
          },
          "returns": "None"
        },
        "get_notebook": {
          "params": {
            "ctx": "RequestContext",
            "notebook_id": "str"
          },
          "returns": "dict|null"
        },
        "list_notebooks": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "list[dict]"
        },
        "migrate_notebook": {
          "params": {
            "ctx": "RequestContext",
            "metadata": "dict",
            "members": "list[dict]"
          },
          "returns": "None"
        },
        "update_notebook": {
          "params": {
            "ctx": "RequestContext",
            "notebook_id": "str",
            "name": "str",
            "description": "str"
          },
          "returns": "None"
        },
        "set_notebook_archived": {
          "params": {
            "ctx": "RequestContext",
            "notebook_id": "str",
            "archived": "bool"
          },
          "returns": "None"
        }
      }
    }
  }
}
