{
  "package": "mcp_servers",
  "delivery": "Cython extension + standalone Nuitka executable (Windows)",
  "version": "0.1.1",
  "note": "Standalone connectors for Git / Issue / Ticket. JSON-RPC over stdio (MCP) plus optional HTTP.",
  "facade": {
    "MockMcpServer": {
      "kind": "class"
    },
    "build_default_server": {
      "kind": "function",
      "params": {},
      "returns": "MockMcpServer"
    }
  },
  "standalone": {
    "entrypoint": "mcp-servers",
    "rpc": {
      "tools/list": "list[ToolDef]",
      "tools/call": {
        "name": "str",
        "arguments": "dict"
      }
    },
    "mock": true
  }
}
