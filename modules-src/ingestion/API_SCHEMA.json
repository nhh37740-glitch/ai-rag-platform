{
  "package": "ingestion",
  "delivery": "Cython extension + standalone Nuitka worker (Windows)",
  "version": "0.2.1",
  "facade": {
    "parse": {
      "kind": "function",
      "params": {
        "path": "str"
      },
      "returns": "list[str]"
    },
    "to_markdown": {
      "kind": "function",
      "params": {
        "path": "str",
        "title": "str"
      },
      "returns": "str"
    },
    "chunk": {
      "kind": "function",
      "params": {
        "texts": "list[str]",
        "size": "int=500",
        "overlap": "int=50"
      },
      "returns": "list[str]"
    },
    "build_index": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "docs_dir": "str",
        "store": "VectorStore",
        "embed_fn": "callable"
      },
      "returns": "int",
      "blocking_io": true
    }
  },
  "standalone": {
    "entrypoint": "ingestion-worker",
    "delivery": "Nuitka exe",
    "http": {
      "POST /ingest": {
        "body": {
          "docs_dir": "str",
          "scope": "str"
        },
        "returns": {
          "indexed": "int"
        }
      }
    }
  }
}
