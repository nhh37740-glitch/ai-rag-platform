{
  "package": "auth_facade",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.5.0",
  "facade": {
    "AuthService": {
      "kind": "class",
      "init": {
        "data": "DataServicePort",
        "session_ttl_seconds": "int=43200",
        "daily_limit": "int=100"
      },
      "methods": {
        "initialize": {
          "params": {
            "ctx": "RequestContext",
            "admin_username": "str",
            "admin_password": "str"
          },
          "returns": "None"
        },
        "register": {
          "params": {
            "ctx": "RequestContext",
            "username": "str",
            "password": "str"
          },
          "returns": "dict"
        },
        "login": {
          "params": {
            "ctx": "RequestContext",
            "username": "str",
            "password": "str"
          },
          "returns": "tuple[AuthPrincipal,str]"
        },
        "authenticate_session": {
          "params": {
            "ctx": "RequestContext",
            "token": "str"
          },
          "returns": "AuthPrincipal"
        },
        "logout": {
          "params": {
            "ctx": "RequestContext",
            "token": "str"
          },
          "returns": "None"
        },
        "guest": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "AuthPrincipal"
        },
        "authorize": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "permission": "str"
          },
          "returns": "None"
        },
        "allowed_notebooks": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "available_ids": "list[str]",
            "public_ids": "list[str]=[]"
          },
          "returns": "list[str]"
        },
        "notebook_permissions": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str"
          },
          "returns": "list[str]"
        },
        "authorize_notebook": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "permission": "str"
          },
          "returns": "None"
        },
        "list_members": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str"
          },
          "returns": "list[dict]"
        },
        "list_share_targets": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str"
          },
          "returns": "list[dict]"
        },
        "set_member": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "user_id": "str",
            "role": "str"
          },
          "returns": "None"
        },
        "remove_member": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "user_id": "str"
          },
          "returns": "None"
        },
        "list_admin_users": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal"
          },
          "returns": "list[dict]"
        },
        "set_user_active": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "user_id": "str",
            "active": "bool"
          },
          "returns": "None"
        },
        "reserve_query": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "dict"
        },
        "quota_status": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "dict"
        }
      }
    }
  }
}
