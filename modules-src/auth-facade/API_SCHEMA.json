{
  "package": "auth_facade",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.3.0",
  "facade": {
    "AuthService": {
      "kind": "class",
      "init": {
        "proxy_token": "str",
        "owner_id": "str",
        "store": "StateStorePort|null"
      },
      "methods": {
        "guest": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "AuthPrincipal"
        },
        "authenticate_proxy": {
          "params": {
            "ctx": "RequestContext",
            "proxy_token": "str",
            "user_id": "str",
            "role": "str"
          },
          "returns": "AuthPrincipal"
        },
        "authorize": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "permission": "str"
          },
          "returns": "None"
        },
        "allowed_notebooks": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "available_ids": "list[str]",
            "public_ids": "list[str]"
          },
          "returns": "list[str]"
        },
        "notebook_permissions": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "public": "bool"
          },
          "returns": "list[str]"
        },
        "authorize_notebook": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "permission": "str",
            "public": "bool"
          },
          "returns": "None"
        },
        "list_members": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str"
          },
          "returns": "list[dict]"
        },
        "set_member": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "user_id": "str",
            "role": "str"
          },
          "returns": "None"
        },
        "remove_member": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal",
            "notebook_id": "str",
            "user_id": "str"
          },
          "returns": "None"
        }
      }
    },
    "DailyQueryQuota": {
      "kind": "class",
      "init": {
        "store": "StateStorePort",
        "limit": "int"
      },
      "methods": {
        "status": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "dict"
        },
        "reserve": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "dict"
        }
      }
    }
  }
}
