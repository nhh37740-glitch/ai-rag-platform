{
  "package": "llm_gateway",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.1.1",
  "facade": {
    "LLMProvider": {
      "kind": "protocol",
      "methods": {
        "generate": {
          "async": true,
          "params": {
            "ctx": "RequestContext",
            "messages": "list[ChatMessage]",
            "tools": "list[ToolDef]|null"
          },
          "returns": "tuple[str,list[ToolCall]]"
        },
        "stream": {
          "async": true,
          "params": {
            "ctx": "RequestContext",
            "messages": "list[ChatMessage]",
            "tools": "list[ToolDef]|null"
          },
          "returns": "async iterator[str]"
        }
      }
    },
    "DeepSeekProvider": {
      "kind": "class",
      "init": {
        "api_key": "str",
        "base_url": "str=https://api.deepseek.com",
        "model": "str=deepseek-chat",
        "transport": "AsyncBaseTransport|null"
      },
      "env": [
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DEEPSEEK_MODEL"
      ]
    },
    "MockProvider": {
      "kind": "class",
      "init": {
        "scenario": "str=qa"
      }
    }
  }
}
