{
  "package": "auth_runtime",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.5.0",
  "facade": {
    "AuthRuntime": {
      "kind": "class",
      "init": {},
      "methods": {
        "hash_password": {
          "params": {
            "password": "str"
          },
          "returns": "str"
        },
        "verify_password": {
          "params": {
            "password": "str",
            "encoded": "str"
          },
          "returns": "bool"
        },
        "issue_principal": {
          "params": {
            "ctx": "RequestContext",
            "user_id": "str",
            "role": "str"
          },
          "returns": "AuthPrincipal"
        },
        "validate_principal": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal"
          },
          "returns": "bool"
        },
        "issue_session": {
          "params": {
            "ctx": "RequestContext",
            "user_id": "str",
            "ttl_seconds": "int"
          },
          "returns": "str"
        },
        "resolve_session": {
          "params": {
            "ctx": "RequestContext",
            "token": "str"
          },
          "returns": "str|null"
        },
        "revoke_session": {
          "params": {
            "ctx": "RequestContext",
            "token": "str"
          },
          "returns": "None"
        }
      }
    }
  }
}
