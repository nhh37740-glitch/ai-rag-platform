{
  "package": "auth_runtime",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.3.0",
  "facade": {
    "AuthRuntime": {
      "kind": "class",
      "init": {
        "proxy_token": "str",
        "owner_id": "str"
      },
      "methods": {
        "guest": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "AuthPrincipal"
        },
        "authenticate_proxy": {
          "params": {
            "ctx": "RequestContext",
            "proxy_token": "str",
            "user_id": "str",
            "role": "str"
          },
          "returns": "AuthPrincipal"
        },
        "is_administrator": {
          "params": {
            "ctx": "RequestContext",
            "principal": "AuthPrincipal"
          },
          "returns": "bool"
        }
      }
    }
  }
}
