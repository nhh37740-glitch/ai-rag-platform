{
  "package": "agent_facade",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.5.3",
  "facade": {
    "make_provider": {
      "kind": "function",
      "params": {
        "api_key": "str",
        "base_url": "str",
        "model": "str",
        "scenario": "str"
      },
      "returns": "LLMProviderPort"
    },
    "AgentService": {
      "kind": "class",
      "init": {
        "data": "DataServicePort",
        "rag": "RagServicePort",
        "tracing": "TraceStorePort|null",
        "skill_dir": "str",
        "provider": "LLMProviderPort|null",
        "max_tool_rounds": "int=10",
        "environment": "dict[str,str]|null"
      },
      "methods": {
        "run": {
          "params": {
            "ctx": "RequestContext",
            "user_input": "str",
            "knowledge_base_ids": "list[str]|null",
            "allow_write_tools": "bool",
            "model_id": "str|null",
            "expected_provider_id": "str|null",
            "history": "list[dict]|null",
            "memory_enabled": "bool"
          },
          "returns": "str",
          "async": true
        },
        "register_tool": {
          "params": {
            "ctx": "RequestContext",
            "definition": "ToolDef",
            "handler": "callable",
            "context_aware": "bool"
          },
          "returns": "None"
        },
        "tool_definitions": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "list[ToolDef]"
        },
        "history": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "list[ChatMessage]"
        },
        "aclose": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "None",
          "async": true
        },
        "list_model_providers": {
          "params": {
            "ctx": "RequestContext",
            "environment": "dict[str,str]"
          },
          "returns": "list[dict]"
        },
        "list_models": {
          "params": {
            "ctx": "RequestContext",
            "provider_id": "str",
            "environment": "dict[str,str]"
          },
          "returns": "list[dict]"
        },
        "get_model_settings": {
          "params": {
            "ctx": "RequestContext"
          },
          "returns": "dict"
        },
        "update_model_settings": {
          "params": {
            "ctx": "RequestContext",
            "provider_id": "str",
            "model_id": "str"
          },
          "returns": "dict"
        },
        "enable_write_tools": {
          "params": {
            "ctx": "RequestContext",
            "files_dir": "str"
          },
          "returns": "None"
        }
      }
    },
    "resolve_model_config": {
      "kind": "function",
      "params": {
        "ctx": "RequestContext",
        "environment": "dict[str,str]",
        "public": "bool"
      },
      "returns": "ModelConfiguration"
    }
  }
}
