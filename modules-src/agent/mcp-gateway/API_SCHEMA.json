{
  "package": "mcp_gateway",
  "delivery": "Cython extension (.pyd/.so)",
  "version": "0.1.1",
  "facade": {
    "McpServerClient": {
      "kind": "protocol",
      "methods": {
        "connect": {
          "async": true,
          "params": {
            "name": "str"
          },
          "returns": "None"
        },
        "list_tools": {
          "async": true,
          "params": {},
          "returns": "list[ToolDef]"
        },
        "call_tool": {
          "async": true,
          "params": {
            "name": "str",
            "arguments": "dict"
          },
          "returns": "str"
        }
      }
    },
    "MockClient": {
      "kind": "class",
      "implements": "McpServerClient"
    },
    "normalize_to_tool": {
      "kind": "function",
      "params": {
        "mcp_tool": "dict"
      },
      "returns": "ToolDef"
    }
  }
}
