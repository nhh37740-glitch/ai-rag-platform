{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public read-only RAG demo HTTP specification",
  "version": "1.2.0",
  "endpoints": {
    "GET /api/demo": {
      "description": "Corpus metadata and featured suggestions; guests may ask any nonempty question within the length limit.",
      "mode_fields": {
        "public_demo": {
          "type": "boolean"
        },
        "read_only": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "mock",
            "deepseek"
          ]
        },
        "embedding": {
          "enum": [
            "hash",
            "fastembed"
          ]
        }
      }
    },
    "POST /api/demo/chat": {
      "request": {
        "$ref": "#/$defs/ChatRequest"
      },
      "response": {
        "$ref": "#/$defs/ChatResponse"
      },
      "errors": [
        403,
        404,
        422,
        429,
        502,
        504
      ],
      "limits": {
        "max_body_bytes": 16384,
        "max_inflight": 1,
        "timeout_seconds": 90,
        "success_cache_ttl_seconds": 300
      },
      "description": "Any nonempty question up to 1024 characters. Optional request-scoped key requires secure same origin; server fixes public scope and identity. Keyed and non-featured questions bypass shared cache. Success requires in-scope retrieval.",
      "request_headers": {
        "x-deepseek-api-key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "optional": true,
          "secure_same_origin": true
        }
      }
    },
    "GET /api/trace/{trace_id}": {
      "description": "Existing SpanEvent array for this isolated public process only; no synthetic spans or private-service data."
    },
    "GET /api/auth/session": {
      "description": "Only user_id, role, permissions, allowed_notebook_ids and mode; never principal proof or proxy credential."
    },
    "GET /api/notebooks": {
      "description": "Guest sees only the built-in cmrc2018-demo notebook; admin sees available private notebooks."
    },
    "GET /api/notebooks/cmrc2018-demo/documents": {
      "description": "Actual public corpus document metadata."
    },
    "GET /api/notebooks/cmrc2018-demo/suggestions": {
      "description": "Public featured suggestions."
    },
    "GET /api/demo/documents/{document_id}": {
      "description": "Read actual CMRC chunks via RagService; no private scopes, offset>=0, max_chunks 1..20."
    }
  },
  "$defs": {
    "ChatRequest": {
      "type": "object",
      "required": [
        "question"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "description": "Trimmed question must be nonempty and at most 1024 characters; extra fields are denied."
    },
    "ChatResponse": {
      "type": "object",
      "required": [
        "answer",
        "trace_id",
        "knowledge_base_ids",
        "provider",
        "embedding",
        "read_only",
        "cache_hit"
      ],
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "knowledge_base_ids": {
          "const": [
            "cmrc2018-demo"
          ]
        },
        "provider": {
          "enum": [
            "mock",
            "deepseek"
          ]
        },
        "embedding": {
          "enum": [
            "hash",
            "fastembed"
          ]
        },
        "read_only": {
          "const": true
        },
        "cache_hit": {
          "type": "boolean"
        }
      }
    }
  }
}
