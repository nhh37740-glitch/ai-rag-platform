# Default real-model mode: inject this key only on the server; never commit it.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional shared quota directory for public/admin containers or multiple workers.
# WEB_QUOTA_STATE_DIR=/opt/agent/web-quota
# Explicit offline compatibility mode: LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=./data/app.db
STATE_DIR=./data
BGE_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBED=fastembed
FASTEMBED_CACHE_PATH=./models/fastembed_cache
MODULES_SRC=./modules-src
ARTIFACTS_DIR=./artifacts
